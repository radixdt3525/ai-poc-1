# Required for AI chat and AI-written insight explanations
OPENAI_API_KEY=
# Any chat-completions model with tool calling
OPENAI_MODEL=gpt-4.1
# Optional: OpenAI-compatible endpoint (Azure/proxy)
# OPENAI_BASE_URL=

# Encrypts saved connection passwords. Any string. If empty, a key is generated and stored in the meta DB.
APP_SECRET_KEY=

# Background optimization scan interval (0 disables the scheduler)
INSIGHTS_INTERVAL_MINUTES=30
# Default max rows returned per statement in the editor
QUERY_ROW_LIMIT=1000
# statement_timeout for editor queries
QUERY_TIMEOUT_SECONDS=120

# Host port for the web UI
APP_PORT=8080
# Host port (127.0.0.1 only) for the app's metadata Postgres: user/password/db = pgplus
META_DB_PORT=5434
